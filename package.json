{
  "name": "@shortcut/client",
  "version": "3.4.0",
  "description": "A library for interacting with the Shortcut REST API",
  "homepage": "https://github.com/useshortcut/shortcut-client-js#readme",
  "bugs": {
    "url": "https://github.com/useshortcut/shortcut-client-js/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/useshortcut/shortcut-client-js.git"
  },
  "files": [
    "lib"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "typesVersions": {
    "*": {
      "v4": [
        "./lib/v4/index.d.cts"
      ],
      "webhooks": [
        "./lib/webhooks/index.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./v4": {
      "import": "./lib/v4/index.mjs",
      "require": "./lib/v4/index.cjs"
    },
    "./webhooks": {
      "import": "./lib/webhooks/index.mjs",
      "require": "./lib/webhooks/index.cjs"
    }
  },
  "scripts": {
    "build": "yarn build:client && yarn build:client:v4 && yarn build:add-typedoc-comments && NODE_OPTIONS=\"--no-experimental-strip-types\" tsdown && node scripts/fix-cjs-dts.mts lib",
    "build:add-typedoc-comments": "npx jscodeshift -t scripts/add-typedoc-comments.ts --extensions=ts --parser=ts src/generated/** src/v4/generated/**",
    "build:client": "swagger-typescript-api generate --path ./schema/shortcut.swagger.json --output ./src/generated --clean-output --axios --modular --templates ./templates",
    "build:client:v4": "swagger-typescript-api generate --path ./schema/shortcut.v4.openapi.json --output ./src/v4/generated --clean-output --modular --extract-request-body --unwrap-response-data --templates ./templates/v4",
    "build:docs": "yarn build:client && yarn build:client:v4 && yarn build:add-typedoc-comments && typedoc && node scripts/finalize-docs.mts",
    "check-exports": "attw --pack . && node scripts/check-package-types.mts && node scripts/check-packed-consumer.mts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint src examples",
    "prepublishOnly": "yarn build",
    "sync:schema": "curl --silent https://developer.shortcut.com/api/rest/v3/shortcut.swagger.json --output ./schema/shortcut.swagger.json && yarn validate:schema",
    "sync:schema:v4": "curl --silent https://developer.shortcut.com/api/rest/v4/shortcut.openapi.json --output ./schema/shortcut.v4.openapi.raw.json && node scripts/normalize-v4-schema.mts ./schema/shortcut.v4.openapi.raw.json ./schema/shortcut.v4.openapi.json && rm ./schema/shortcut.v4.openapi.raw.json && yarn validate:schema:v4",
    "test": "vitest",
    "validate:examples": "npx tsc --project examples/tsconfig.json",
    "validate:schema": "swagger-cli validate ./schema/shortcut.swagger.json && yarn validate:schema:v4",
    "validate:schema:v4": "swagger-cli validate ./schema/shortcut.v4.openapi.json"
  },
  "dependencies": {
    "axios": "^1.15.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.1",
    "@total-typescript/tsconfig": "1.0.4",
    "@types/jscodeshift": "17.3.0",
    "@types/node": "22.15.30",
    "jscodeshift": "17.3.0",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "stream-to-blob": "2.0.1",
    "swagger-cli": "4.0.4",
    "swagger-typescript-api": "13.12.2",
    "tsdown": "0.21.10",
    "typedoc": "0.28.19",
    "typedoc-plugin-merge-modules": "7.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "packageManager": "yarn@4.14.1+sha512.64df448055b2d37ba269d7db535a469b8da93f8ef1140c25fd7a83c00a8fbaacb214ca0e02553b92a2c54cef78bb67d0b4817fab02001df0e24fac0faccc3b42"
}
